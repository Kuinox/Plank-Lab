<Project Sdk="Microsoft.NET.Sdk">

  <!-- Scale / concurrency driver: not an AFL target. Writes files that cross the library's size
       thresholds (millions of rows, dictionary fallback, big pages, many columns/row groups, >2/4 GB)
       and reads them back with every Plank read API, multi-threaded, and with ParquetSharp. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <NoWarn>$(NoWarn);CS1591;CA1031;CA1303;CA1822;CA2007;CA1062</NoWarn>
    <ServerGarbageCollection>false</ServerGarbageCollection>
    <TieredPGO>true</TieredPGO>
    <EmitCompilerGeneratedFiles>true</EmitCompilerGeneratedFiles>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="ParquetSharp" Version="24.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\library\Plank\Plank\Plank.csproj" />
    <ProjectReference Include="..\library\Plank\Plank.SourceGen\Plank.SourceGen.csproj"
                      OutputItemType="Analyzer"
                      ReferenceOutputAssembly="false" />
  </ItemGroup>

</Project>
