<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\library\Plank\Plank\Plank.csproj" />
    <ProjectReference Include="..\library\Plank\Plank.SourceGen\Plank.SourceGen.csproj"
                      OutputItemType="Analyzer"
                      ReferenceOutputAssembly="false" />
  </ItemGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <PackageReference Include="BenchmarkDotNet" Version="0.15.8" />
    <PackageReference Include="Parquet.Net" Version="6.0.3" />
    <PackageReference Include="ParquetSharp" Version="24.0.0" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <!-- Compare old Plank revisions with GetRow and cursor-capable revisions with
       their reusable cursor API, without reflection in the measured loop.
       Override PlankUseRowCursor=false to measure the compatibility API. -->
  <PropertyGroup>
    <PlankUseRowCursor Condition="'$(PlankUseRowCursor)' == '' and Exists('..\library\Plank\Plank.SourceGen\RowCursorEmitter.cs')">true</PlankUseRowCursor>
    <DefineConstants Condition="'$(PlankUseRowCursor)' == 'true'">$(DefineConstants);PLANK_ROW_CURSOR</DefineConstants>
  </PropertyGroup>

</Project>
