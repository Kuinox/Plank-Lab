<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <AnalysisLevel>latest</AnalysisLevel>
    <AnalysisMode>All</AnalysisMode>
    <NoWarn>$(NoWarn);CA1822;CA5392;CA1031;CA2000;CA1806</NoWarn>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\Plank.Fuzzing.Harness\AflPersistentHarness.cs" Link="AflPersistentHarness.cs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="SharpFuzz" Version="2.2.0" />
    <PackageReference Include="SharpFuzz.Common" Version="2.2.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Plank.Fuzzing\Plank.Fuzzing.csproj" />
    <!-- Built for its output only: a SharpFuzz.Common with a [ThreadStatic] PrevLocation, copied over the package dll after instrumenting. -->
    <ProjectReference Include="..\Plank.Fuzzing.TraceShim\Plank.Fuzzing.TraceShim.csproj" ReferenceOutputAssembly="false" />
  </ItemGroup>

  <Target Name="SharpFuzzInstrument" AfterTargets="Build">
    <Exec Command="sharpfuzz &quot;$(OutDir)Plank.dll&quot;" />
    <Exec Command="sharpfuzz &quot;$(OutDir)Plank.Fuzzing.dll&quot;" />
    <!-- Per-thread edge chains: multithreaded code (row pipelines) otherwise maps different edges on every run. -->
    <Copy SourceFiles="$(MSBuildThisFileDirectory)..\Plank.Fuzzing.TraceShim\bin\$(Configuration)\netstandard2.0\SharpFuzz.Common.dll" DestinationFolder="$(OutDir)" Condition="'$(PLANK_FUZZ_STOCK_TRACE)' != '1'" />
  </Target>

</Project>
